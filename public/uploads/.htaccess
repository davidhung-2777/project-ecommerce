# Allow access to uploaded files
<FilesMatch "\.(jpg|jpeg|png|webp|gif)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Deny access to PHP files in uploads
<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Enable CORS for images
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
