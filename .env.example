# Application
APP_NAME="DecorNest"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/project-ecommerce/public

# Database
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=decornest
DB_USERNAME=root
DB_PASSWORD=

# Payment Gateway - VietQR (SePay or Casso)
VIETQR_PROVIDER=sepay
VIETQR_API_KEY=your_api_key_here
VIETQR_ACCOUNT_NUMBER=your_bank_account_number
VIETQR_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
VIETQR_BANK_CODE=VCB
VIETQR_TEMPLATE=compact
VIETQR_WEBHOOK_SECRET=your_webhook_secret_here

# MoMo Payment
MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create

# VNPay
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Mail (Optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@decornest.com
MAIL_FROM_NAME="${APP_NAME}"

# Shipping - Giao Hàng Nhanh (GHN)
GHN_API_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_shop_id_here
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
# Sau khi test xong, chuyển sang production:
# GHN_API_URL=https://online-gateway.ghn.vn/shiip/public-api

# Thông tin kho hàng (để tính phí ship)
GHN_FROM_DISTRICT_ID=1542
# 1542 = Quận Ba Đình, Hà Nội (Thay bằng mã quận kho hàng của bạn)
GHN_FROM_WARD_CODE=20308
# Mã phường/xã kho hàng của bạn
